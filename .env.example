# Copy to `.env` (gitignored) for local development. Never put secrets in VITE_* variables:
# every VITE_* value is bundled into the public browser code.

# Early Step backend API base URL — must end with `/api/`. Feature paths are relative to it
# (e.g. `Parent/GetMyChildren`), so never add a second `/api` in request paths.
VITE_API_BASE_URL=https://earlystep22.runasp.net/api/

# Development only: serve every API call from the local mock server (MSW) instead of the backend.
# Shows a "وضع المحاكاة" banner. Ignored in production builds.
VITE_USE_MOCKS=false
