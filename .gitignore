# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
coverage/
*.tsbuildinfo

# Environment — never commit real values. Only .env.example is tracked.
.env
.env.*
!.env.example

# Local credential notes (demo accounts etc.) — never commit
*.local
*.secret*
credentials*

# Logs
logs
*.log
npm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.sw?

# Claude Code local settings
.claude/settings.local.json
